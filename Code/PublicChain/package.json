{
  "name": "supermarket-trace-public-chain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local EVM deployment and snapshot publication tools for Supermarket-Trace-v1",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "publish:local": "hardhat run scripts/publish_snapshot.js --network localhost",
    "query:local": "hardhat run scripts/query_snapshot.js --network localhost",
    "consumer": "node consumer_server.js"
  },
  "engines": {
    "node": ">=22.10.0 <25"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.0.21",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^5.1.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.14.0",
    "hardhat": "3.11.1",
    "mocha": "^11.0.0"
  }
}
